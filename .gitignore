# =========================================================
# GITIGNORE - UNIRIDE CARONAS UNIVERSITÁRIAS
# =========================================================

# Compilação e artefatos de build Java
*.class
bin/
build/
out/
target/

# Logs e arquivos de execução da JVM
*.log
hs_err_pid*
replay_pid*

# Arquivos de IDEs e Editores
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath
.nbproject/
nbproject/
.ctxt
.mtj.tmp/

# Variáveis de ambiente e segredos locais
.env
.env.local
.env.*.local
*.env
!*.env.example
!.env.example

# Arquivos temporários e do Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.tmp
*.temp
*.argfile

# Pacotes (bloqueia jars genéricos, preserva dependências de lib/)
*.jar
!lib/*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
