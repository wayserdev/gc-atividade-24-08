# =========================================================
# CONFIGURAÇÃO DE AMBIENTE - UNIRIDE CARONAS UNIVERSITÁRIAS
# =========================================================
# Copie este arquivo para '.env' caso utilize conexao direta
# com o banco de dados PostgreSQL ou servico de backend.

# Banco de Dados PostgreSQL (Opcional / Producao)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uniride_db
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Configuracao da API / Servidor
API_HOST=localhost
API_PORT=8080
API_URL=http://localhost:8080/api

# Seguranca e JWT (Exemplo ficticio)
JWT_SECRET=chave_secreta_jwt_exemplo_uniride_2026
JWT_EXPIRATION_HOURS=24

# Modo de Execucao (MOCK ou DATABASE)
APP_ENV=development
DATA_SOURCE=MOCK
